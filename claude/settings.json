{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "MCP_TIMEOUT": "90000"
  },
  "permissions": {
    "deny": [
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.codex/AGENTS.md)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.production)",
      "Read(//**/.env.development)",
      "Read(//**/.env.staging)",
      "Read(//**/*.pem)",
      "Read(//**/*.p12)",
      "Read(//**/id_rsa)",
      "Read(//**/id_ed25519)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git add -A)",
      "Bash(git add -A .)",
      "Bash(git add .)",
      "Bash(git add --all)",
      "Bash(git add --all .)",
      "Bash(git commit -a*)",
      "Bash(git commit --all*)",
      "Bash(git push --force* origin main)",
      "Bash(git push --force* origin main *)",
      "Bash(git push --force* origin main:*)",
      "Bash(git push --force* origin HEAD:main)",
      "Bash(git push --force* origin HEAD:main *)",
      "Bash(git push -f* origin main)",
      "Bash(git push -f* origin main *)",
      "Bash(git push -f* origin main:*)",
      "Bash(git push -f* origin HEAD:main)",
      "Bash(git push -f* origin HEAD:main *)",
      "Bash(git push origin +main)",
      "Bash(git push origin +main *)",
      "Bash(git push origin +main:*)",
      "Bash(sudo *)"
    ],
    "allow": [
      "Bash(python3 {{KIT}}/bin/learn.py *)",
      "Bash(python3 {{KIT}}/bin/lint.py *)",
      "Bash(bash {{KIT}}/install.sh --check)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Agent|Task|mcp__.*(execute_sql|apply_migration|d1_database_query|run_sql|sql_query)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/agent-core/guard.py || true",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/agent-core/budget.py || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/agent-core/capture.py || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/agent-core/capture.py || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/agent-core/session_start.py || true",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/agent-core/stop_steps.py || true",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "cleanupPeriodDays": 90
}
